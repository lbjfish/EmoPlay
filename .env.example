# Copy this file to .env locally, then fill values. Never commit .env.
AZURE_TEXT_ENDPOINT=
AZURE_TEXT_API_KEY=
AZURE_TEXT_MODEL=gpt-5.6-sol

# Secondary text provider. Azure remains primary.
DEEPSEEK_ENDPOINT=
DEEPSEEK_API_KEY=
DEEPSEEK_TEXT_MODEL=

AZURE_IMAGE_ENDPOINT=
AZURE_IMAGE_API_KEY=
AZURE_IMAGE_MODEL=gpt-image-2

VOICE_ENDPOINT=
VOICE_API_KEY=
VOICE_MODEL=

# Optional local adapters. Leave empty when unavailable.
LOCAL_TEXT_ENDPOINT=
LOCAL_TEXT_MODEL=
COMFYUI_ENDPOINT=
PIPER_EXECUTABLE=

# Live tests are opt-in and remain disabled by default.
RUN_LIVE_TESTS=0



